; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Tecate Simulator Facade MVP"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://branding/icon.png"

[dotnet]

project/assembly_name="Tecate Simulator Facade MVP"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="fractional"

[rendering]

textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.894118, 0.894118, 0.894118, 1)

[physics]

common/physics_interpolation=true

[debug]

settings/file_logging/enable_file_logging=false
settings/file_logging/enable_file_logging.pc=false
file_logging/enable_file_logging=false

[network]

tkt/server_host="api.tecate.bonsanbec.dev"
tkt/server_port=52665
tkt/tick_rate=30
tkt/session_timeout=10.0
tkt/interpolation_delay=0.10
tkt/local_dev=false
tkt/debug_net=false

[autoload]

StreetNameLookup="*res://systems/urban/street_name_lookup.gd"
NetworkConfig="*res://systems/network/network_config.gd"
