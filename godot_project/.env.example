# ==============================================================================
# Configuración del Cliente Godot Tecate Simulator (TKT/1)
# ==============================================================================

# Dirección del Servidor de Juego TKT/1 (VPS Bonsanbec)
TECATE_SERVER_HOST=api.tecate.bonsanbec.dev
TECATE_SERVER_PORT=52665

# Activar modo desarrollo local (fuerza conexión a 127.0.0.1)
TECATE_LOCAL_DEV=false

# Tasa de envío de paquetes de movimiento (Hz)
TECATE_TICK_RATE=30

# Registro detallado de red en consola
TECATE_DEBUG_NET=false
