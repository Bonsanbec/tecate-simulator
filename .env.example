# ==============================================================================
# Configuración Global de Entorno: Tecate Simulator & Servidor TKT/1
# ==============================================================================

# Configuración del Servidor de Juego en VPS (server/)
SERVER_BIND_HOST=0.0.0.0
SERVER_PORT=52665
PUBLIC_DOMAIN=bonsanbec.dev
PUBLIC_SUBDOMAIN=api.tecate
PUBLIC_HOST=api.tecate.bonsanbec.dev

# Frecuencia de Ticks y Tiempos
TICK_RATE=30
SESSION_TIMEOUT_SECONDS=10.0
MAX_CLIENTS=64
SPATIAL_GRID_CELL_SIZE=150.0
BROADCAST_RADIUS_CELLS=1
LOG_LEVEL=INFO

# Configuración del Cliente Godot (godot_project/)
TECATE_SERVER_HOST=api.tecate.bonsanbec.dev
TECATE_SERVER_PORT=52665
TECATE_LOCAL_DEV=false
TECATE_TICK_RATE=30
TECATE_DEBUG_NET=false
