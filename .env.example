# ==============================================================================
# Tecate Simulator Environment Configuration (Example)
# Copy this file to '.env' and edit the variables as needed.
# ==============================================================================

# --- Minecraft Pipeline Exporter Settings ---
# Path to the JSON input describing reconstructed roads and structures
IMPORT_JSON=export/reconstruction_export.json

# Path to the terrain elevation GLB file (used for exporter height calculation)
GLB_PATH=models/tecate/glb/tecate.glb

# --- Minecraft Pipeline Importer Settings ---
# Path to the reference fresh Minecraft world
FRESH_WORLD=export/minecraft_world/TecateWorld

# Path to your active player-modified save directory
# macOS Default: /Users/<your_user>/Library/Application Support/minecraft/saves/TecateWorld
# Windows Default: C:/Users/<your_user>/AppData/Roaming/.minecraft/saves/TecateWorld
# Linux Default: ~/.minecraft/saves/TecateWorld
MODIFIED_WORLD=export/minecraft_world/TecateWorld

# --- Shared Directory Settings ---
# Output folder where Blender models (.blend, .glb) and checkpoints are generated
OUTPUT_DIR=export/minecraft_world

