{
  "name": "tecate-spatial-memory-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline tooling for a Godot C# pedestrian urban simulator set in Tecate, Baja California.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "structure:validate": "tsx tools/validation/validate-repository-structure.ts",
    "metadata:validate": "tsx tools/validation/validate-metadata.ts",
    "data:integrity": "tsx tools/validation/verify-data-integrity.ts",
    "tiles:generate": "tsx tools/generators/generate-basic-chunks.ts",
    "tiles:assets": "tsx tools/generators/generate-tile-assets.ts",
    "tiles:validate": "tsx tools/validation/validate-tile-structure.ts",
    "tiles:package": "tsx tools/packaging/package-tiles.ts",
    "coords:convert": "tsx tools/converters/convert-coordinates.ts",
    "geojson:import": "tsx tools/importers/import-geojson.ts",
    "osm:fetch": "tsx tools/importers/fetch-osm-tecate.ts",
    "dem:generate": "tsx tools/generators/generate-terrain-dem.ts",
    "debug:summary": "tsx tools/debug/print-project-summary.ts",
    "validate": "npm run structure:validate && npm run metadata:validate && npm run data:integrity && npm run tiles:validate"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
