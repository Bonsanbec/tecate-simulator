# ==============================================================================
# Configuración del Servidor Multijugador Tecate Simulator (TKT/1)
# ==============================================================================

# Parámetros de Red y Socket UDP
SERVER_BIND_HOST=0.0.0.0
SERVER_PORT=52665

# Dominio y Subdominios Públicos VPS (Red Bonsanbec)
PUBLIC_DOMAIN=bonsanbec.dev
PUBLIC_SUBDOMAIN=api.tecate
PUBLIC_HOST=api.tecate.bonsanbec.dev

# Frecuencia de Simulación y Red (Ticks por segundo)
TICK_RATE=30

# Tiempos de Espera y Límites
SESSION_TIMEOUT_SECONDS=10.0
MAX_CLIENTS=64
MAX_PACKET_SIZE=1400

# Gestión Espacial (Interest Management)
SPATIAL_GRID_CELL_SIZE=150.0
BROADCAST_RADIUS_CELLS=1

# Seguridad y Autenticación
AUTH_REQUIRED=false
AUTH_SECRET_KEY=tecate_insecure_dev_key_cambiar_en_produccion

# Nivel de Registro (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
