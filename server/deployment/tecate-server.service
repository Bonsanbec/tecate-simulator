[Unit]
Description=Tecate Simulator TKT/1 Game Server
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/tecate-simulator/server
EnvironmentFile=/opt/tecate-simulator/server/.env
ExecStart=/usr/bin/python3 -u main.py
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
